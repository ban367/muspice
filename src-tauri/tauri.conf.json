{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muspice",
  "version": "0.1.0",
  "identifier": "com.ban367.muspice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "muspice",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: albumart: http://albumart.localhost; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: albumart: http://albumart.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp3"],
        "name": "MP3 Audio",
        "contentTypes": ["public.mp3"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["flac"],
        "name": "FLAC Audio",
        "contentTypes": ["org.xiph.flac"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["wav"],
        "name": "WAV Audio",
        "contentTypes": ["com.microsoft.waveform-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["m4a"],
        "name": "MPEG-4 Audio",
        "contentTypes": ["com.apple.m4a-audio", "public.mpeg-4-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["aac"],
        "name": "AAC Audio",
        "contentTypes": ["public.aac-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["mp2"],
        "name": "MP2 Audio",
        "contentTypes": ["public.mp2"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["aiff", "aif"],
        "name": "AIFF Audio",
        "contentTypes": ["public.aiff-audio", "public.aifc-audio"],
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["ogg"],
        "name": "Ogg Vorbis Audio",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["opus"],
        "name": "Opus Audio",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["wv"],
        "name": "WavPack Audio",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["ape"],
        "name": "Monkey's Audio",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
